# Copy to .env for a provider-managed database, or run npm run db:setup:local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Required only for automated database/browser tests; must end in _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/veltrix_test
DATABASE_POOL_SIZE=5
# At least 32 cryptographically random characters; keep stable across restarts.
AUTH_SECRET=REPLACE_WITH_A_GENERATED_SECRET
APP_URL=https://your-veltrix-domain.example
NEXTAUTH_URL=https://your-veltrix-domain.example
# Google OAuth remains disabled unless BOTH values are configured.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production account email requires SMTP. The SMTP adapter uses Nodemailer 10.
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@SMTP_HOST:465
EMAIL_FROM=Veltrix Rentals <no-reply@your-domain.example>
# Local-only private mailbox. Never enable this for production customer accounts.
ALLOW_LOCAL_MAIL=false
# LOCAL_MAIL_DIRECTORY=/absolute/private/path/veltrix-mail
# Explicit opt-in for dedicated development/demo inventory and accounts only.
DEMO_SEED=false
# Future private identity storage: persistent, outside public/ and deployment artifacts.
# PRIVATE_DOCUMENT_DIRECTORY=/absolute/private/path/veltrix-documents
# Test-mode payment credentials will be introduced in the payment milestone.
